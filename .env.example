# ============================================
# Visitor Management System — Environment Config
# ============================================
# Copy this file to server/.env and fill in your values.
# DO NOT commit server/.env to version control.
# ============================================

# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=https://prithwi-vms.vercel.app

# ---- Database (Local Postgres or Supabase) ----
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<your-project-ref>.supabase.co:5432/postgres
# DB_DIALECT=postgres
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=vms_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# ---- JWT, Cookies & QR Signatures (Required strong secrets in production) ----
JWT_SECRET=replace-with-at-least-32-byte-random-secret
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=replace-with-different-32-byte-random-secret
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-32-byte-cookie-secret
QR_HMAC_SECRET=replace-with-32-byte-qr-hmac-secret

# ---- Initial Seeding ----
# Required when seeding in production
# SEED_DEFAULT_PASSWORD=
# ALLOW_DEMO_SEED=false
